#!/usr/bin/python3 -I
"""Root-only Argo input guard. Administrator configuration defines its scope."""
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

CONFIG = Path('/etc/argo/projection-firewall.json')
NFT = '/usr/sbin/nft'


def trusted(path):
    for entry in [path, *path.parents]:
        info = entry.lstat()
        if info.st_uid != 0 or info.st_mode & 0o022 or stat.S_ISLNK(info.st_mode):
            raise ValueError('Helper configuration must be root-owned, immutable to runtime accounts, and not symlinked')


def validate(action, iface, configuration):
    if action not in ('start', 'stop'):
        raise ValueError('Only start and stop are permitted')
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,14}', iface):
        raise ValueError('Invalid interface')
    if iface not in configuration['interfaces']:
        raise ValueError('Interface is not administrator-approved')
    # Stable across radio disappearance/ifindex reuse: stop never needs a live radio.
    return 'argo_projection_' + hashlib.sha256(iface.encode('ascii')).hexdigest()[:16]


def main():
    if os.geteuid() != 0 or len(sys.argv) != 3:
        raise ValueError('Usage (via pkexec): argo-projection-firewall start|stop APPROVED_INTERFACE')
    trusted(CONFIG)
    if not stat.S_ISREG(CONFIG.stat().st_mode) or CONFIG.stat().st_size > 4096:
        raise ValueError('Invalid administrator configuration')
    config = json.loads(CONFIG.read_text())
    action, iface = sys.argv[1:]
    table = validate(action, iface, config)
    if action == 'start' and not Path('/sys/class/net', iface, 'phy80211').exists():
        raise ValueError('Only an existing wireless interface can start a guard')
    env = {'PATH': '/usr/sbin:/usr/bin', 'LANG': 'C'}
    result = subprocess.run([NFT, '-j', 'list', 'tables'], capture_output=True,
                            check=True, timeout=5, env=env)
    tables = json.loads(result.stdout)['nftables']
    exists = any(t.get('table', {}).get('name') == table and
                 t.get('table', {}).get('family') == 'inet' for t in tables)
    if action == 'stop':
        if exists:
            subprocess.run([NFT, 'delete', 'table', 'inet', table], check=True, timeout=5, env=env)
        return
    rules = (f'delete table inet {table}\n' if exists else '') + f'''table inet {table} {{
 chain input {{
  type filter hook input priority -10; policy accept;
  iifname "{iface}" ct state established,related accept
  iifname "{iface}" udp dport {{ 53, 67 }} accept
  iifname "{iface}" tcp dport {{ 53, 5288 }} accept
  iifname "{iface}" drop
 }}
}}
'''
    subprocess.run([NFT, '-f', '-'], input=rules.encode(), check=True, timeout=5, env=env)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, KeyError, subprocess.SubprocessError) as error:
        sys.exit(str(error))
